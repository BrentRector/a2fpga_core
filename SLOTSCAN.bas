10 REM *** PASCAL CKPAGE / ID-BYTE TEST (APPLE ][+) ***
20 REM CHECKS SLOTS 1-7 FOR PASCAL-COMPATIBLE ROM STABILITY
30 REM AND PRINTS BYTES AT OFFSETS 5,7,11
40 PRINT "PASCAL ROM CHECK (CKPAGE-STYLE)"
50 FOR S = 1 TO 7
60  BASE = 49152 + 256*S      : REM $C000 + S*$100
70  PRINT : PRINT "SLOT";S;"  ROM BASE=$";: GOSUB 500
80  REM ---- FIRST PASS SUM ----
90  SUM1 = 0
100  FOR Y = 0 TO 255
110   SUM1 = SUM1 + PEEK(BASE+Y)
120  NEXT Y
130  REM ---- SECOND PASS SUM ----
140  SUM2 = 0
150  FOR Y = 0 TO 255
160   SUM2 = SUM2 + PEEK(BASE+Y)
170  NEXT Y
180  PRINT "  SUM1=";SUM1;"  SUM2=";SUM2;
190  IF SUM1 = SUM2 THEN PRINT "  CKPAGE OK" ELSE PRINT "  UNSTABLE ROM"
200  REM ---- KEY ID BYTES ----
210  B5 = PEEK(BASE+5)
220  B7 = PEEK(BASE+7)
230  B11 = PEEK(BASE+11)
240  PRINT "  BYTES[5,7,11] = ";B5;",";B7;",";B11
250 NEXT S
260 END
500 REM HEX PRINT OF BASE (A=BASE)
510 A = BASE
520 H$ = "0123456789ABCDEF"
530 H1 = INT(A/4096): A = A-4096*H1
540 H2 = INT(A/256):  A = A-256*H2
550 H3 = INT(A/16):   H4 = A-16*H3
560 PRINT MID$(H$,H1+1,1);MID$(H$,H2+1,1);MID$(H$,H3+1,1);MID$(H$,H4+1,1);
570 RETURN
